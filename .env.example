# Copy this file to .env and fill in your own Supabase project's values.
# Find both under Project Settings -> API in the Supabase dashboard.
# These are EXPO_PUBLIC_ vars, which Expo inlines into the client bundle at
# build time -- that's expected for the anon key (it's meant to be public
# and is scoped entirely by the Row Level Security policies in
# supabase/migrations/0001_init.sql). NEVER put the service_role key here or
# anywhere in this app; it must only ever live server-side.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
